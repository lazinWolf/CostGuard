# Local Compose values. Never commit live provider keys.
POSTGRES_PASSWORD=costguard-local
BIFROST_ENCRYPTION_KEY=replace-with-a-long-random-local-secret
BIFROST_SETUP_TOKEN=replace-with-a-random-local-setup-token
# Optional virtual key for an authenticated Bifrost inference endpoint.
BIFROST_VIRTUAL_KEY=
# Enable the browser's mock-demo setup action when running --profile demo.
COSTGUARD_DEMO=0
